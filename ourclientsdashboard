            function populateFilterOptions() {
                const alcaldias = [...new Set(clients.map(c => c.alcaldia).filter(Boolean))].sort();
                const profesiones = [...new Set(clients.map(c => c.profesion).filter(p => p && p !== 'No especificada'))].sort();
                const alcalSelect = document.getElementById('alcaldiaSelectSticky');
                const profSelect = document.getElementById('profesionSelectSticky');
                if (alcalSelect) alcalSelect.innerHTML = '<option value="all">Todas las Alcaldías</option>' + alcaldias.map(a => `<option value="${a}">${a}</option>`).join('');
                if (profSelect) profSelect.innerHTML = '<option value="all">Todas las Profesiones</option>' + profesiones.map(p => `<option value="${p}">${p}</option>`).join('');
            }

            function applyFiltersAndRender() {
                let filteredClientsTemp = [...clients];
                let filteredTransactionsTemp = [...transactions];

                if (selectedSegments.length > 0) {
                    filteredClientsTemp = filteredClientsTemp.filter(c => selectedSegments.includes(c.segmento));
                    filteredTransactionsTemp = filteredTransactionsTemp.filter(t => selectedSegments.includes(t.segmento));
                }

                const sexVal = document.getElementById('sexFilter')?.value;
                if (sexVal && sexVal !== 'all') {
                    filteredClientsTemp = filteredClientsTemp.filter(c => c.sexo === sexVal);
                    filteredTransactionsTemp = filteredTransactionsTemp.filter(t => t.sexoClean === sexVal);
                }
                const startDateVal = document.getElementById('startDate')?.value;
                const endDateVal = document.getElementById('endDate')?.value;
                if (startDateVal) {
                    const start = new Date(startDateVal);
                    filteredClientsTemp = filteredClientsTemp.filter(c => c.fechaFirma && c.fechaFirma >= start);
                    filteredTransactionsTemp = filteredTransactionsTemp.filter(t => t.fechaFirma && t.fechaFirma >= start);
                }
                if (endDateVal) {
                    const end = new Date(endDateVal);
                    end.setHours(23,59,59);
                    filteredClientsTemp = filteredClientsTemp.filter(c => c.fechaFirma && c.fechaFirma <= end);
                    filteredTransactionsTemp = filteredTransactionsTemp.filter(t => t.fechaFirma && t.fechaFirma <= end);
                }
                const minPrice = parseFloat(document.getElementById('minPrice')?.value);
                const maxPrice = parseFloat(document.getElementById('maxPrice')?.value);
                if (!isNaN(minPrice)) {
                    filteredClientsTemp = filteredClientsTemp.filter(c => c.precio_total !== null && c.precio_total >= minPrice);
                    filteredTransactionsTemp = filteredTransactionsTemp.filter(t => t.precio_total !== null && t.precio_total >= minPrice);
                }
                if (!isNaN(maxPrice)) {
                    filteredClientsTemp = filteredClientsTemp.filter(c => c.precio_total !== null && c.precio_total <= maxPrice);
                    filteredTransactionsTemp = filteredTransactionsTemp.filter(t => t.precio_total !== null && t.precio_total <= maxPrice);
                }
                const minAge = parseInt(document.getElementById('minAge')?.value);
                const maxAge = parseInt(document.getElementById('maxAge')?.value);
                if (!isNaN(minAge)) {
                    filteredClientsTemp = filteredClientsTemp.filter(c => c.edad !== null && c.edad >= minAge);
                    filteredTransactionsTemp = filteredTransactionsTemp.filter(t => t.edad !== null && t.edad >= minAge);
                }
                if (!isNaN(maxAge)) {
                    filteredClientsTemp = filteredClientsTemp.filter(c => c.edad !== null && c.edad <= maxAge);
                    filteredTransactionsTemp = filteredTransactionsTemp.filter(t => t.edad !== null && t.edad <= maxAge);
                }
                const alcaldiaSel = document.getElementById('alcaldiaSelectSticky')?.value;
                if (alcaldiaSel && alcaldiaSel !== 'all') {
                    filteredClientsTemp = filteredClientsTemp.filter(c => c.alcaldia === alcaldiaSel);
                    filteredTransactionsTemp = filteredTransactionsTemp.filter(t => t.alcaldiaClean === alcaldiaSel);
                }
                const profesionSel = document.getElementById('profesionSelectSticky')?.value;
                if (profesionSel && profesionSel !== 'all') {
                    filteredClientsTemp = filteredClientsTemp.filter(c => c.profesion === profesionSel);
                    filteredTransactionsTemp = filteredTransactionsTemp.filter(t => t.profesion === profesionSel);
                }
                const propFilter = document.getElementById('propFilter')?.value;
                if (propFilter && propFilter !== 'all') {
                    const target = parseInt(propFilter);
                    if (target === 4) {
                        filteredClientsTemp = filteredClientsTemp.filter(c => c.numPropiedades >= 4);
                        filteredTransactionsTemp = filteredTransactionsTemp.filter(t => t.numPropiedades >= 4);
                    } else {
                        filteredClientsTemp = filteredClientsTemp.filter(c => c.numPropiedades === target);
                        filteredTransactionsTemp = filteredTransactionsTemp.filter(t => t.numPropiedades === target);
                    }
                }

                filteredClients = filteredClientsTemp;
                filteredTransactions = filteredTransactionsTemp;
                applySortingToFilteredTransactions();
                currentPage = 1;
                renderAll();
            }

            function applySortingToFilteredTransactions() {
                if (!filteredTransactions.length) return;
                const column = sortColumn;
                const direction = sortDirection;
                filteredTransactions.sort((a, b) => {
                    let valA, valB;
                    switch(column) {
                        case 'cliente': valA = (a.clienteNombre || '').toLowerCase(); valB = (b.clienteNombre || '').toLowerCase(); break;
                        case 'edad': valA = a.edad !== null ? a.edad : -Infinity; valB = b.edad !== null ? b.edad : -Infinity; break;
                        case 'sexo': valA = a.sexoClean || ''; valB = b.sexoClean || ''; break;
                        case 'perfil': valA = a.segmento || ''; valB = b.segmento || ''; break;
                        case 'propiedades': valA = a.numPropiedades; valB = b.numPropiedades; break;
                        case 'alcaldia': valA = a.alcaldiaClean || ''; valB = b.alcaldiaClean || ''; break;
                        case 'estado_civil': valA = a.estado_civil || ''; valB = b.estado_civil || ''; break;
                        case 'fecha_firma': valA = a.fechaFirma ? a.fechaFirma.getTime() : -Infinity; valB = b.fechaFirma ? b.fechaFirma.getTime() : -Infinity; break;
                        case 'precio_total': valA = a.precio_total !== null ? a.precio_total : -Infinity; valB = b.precio_total !== null ? b.precio_total : -Infinity; break;
                        case 'comentarios': valA = (a.comentarios || '').toLowerCase(); valB = (b.comentarios || '').toLowerCase(); break;
                        default: valA = (a.clienteNombre || '').toLowerCase(); valB = (b.clienteNombre || '').toLowerCase();
                    }
                    if (valA === valB) return 0;
                    let comparison = valA > valB ? 1 : -1;
                    return direction === 'asc' ? comparison : -comparison;
                });
            }

            function renderAll() { updateKPIs(); updateCharts(); renderTableWithPagination(); updatePaginationControls(); }

            function updateKPIs() {
                const total = filteredClients.length;
                const ages = filteredClients.map(c => c.edad).filter(a => a !== null && !isNaN(a));
                const avgAge = ages.length ? (ages.reduce((a,b)=>a+b,0)/ages.length).toFixed(1) : '-';
                const prices = filteredClients.map(c => c.precio_total).filter(p => p && p > 0);
                const avgPriceM = prices.length ? (prices.reduce((a,b)=>a+b,0)/prices.length/1e6).toFixed(2) : '0';
                let fechasValidas = filteredClients.map(c=>c.fechaFirma).filter(f => f);
                let rangeStr = '-';
                if (fechasValidas.length) {
                    let minDate = new Date(Math.min(...fechasValidas));
                    let maxDate = new Date(Math.max(...fechasValidas));
                    rangeStr = `${minDate.toLocaleDateString()} - ${maxDate.toLocaleDateString()}`;
                }
                document.getElementById('totalClients').innerText = total;
                document.getElementById('avgAge').innerText = avgAge !== '-' ? avgAge : '—';
                document.getElementById('avgPrice').innerText = `$${avgPriceM}M`;
                document.getElementById('dateRangeKpi').innerHTML = rangeStr;
            }

            const colorPrimary = '#52BEC0';
            const colorSecondary = '#00FFFF';
            const colorBlack = '#000000';

            let charts = {};
            function updateCharts() {
                // 1. Scatter plot
                const maxY = 5000000;
