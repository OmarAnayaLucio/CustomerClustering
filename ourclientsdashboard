<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=yes">
    <title>Altaltium · Dashboard con Tabla Corregida y Porcentajes en Barras</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:opsz,wght@14..32,300;400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/chartjs-plugin-datalabels@2.0.0/dist/chartjs-plugin-datalabels.min.js"></script>
    <script src="https://cdn.sheetjs.com/xlsx-0.20.2/package/dist/xlsx.full.min.js"></script>
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body { font-family: 'Inter', sans-serif; background: #EBEBEE; color: #000000; padding-top: 0; }
        .sticky-filters {
            position: sticky; top: 0; z-index: 1000;
            background: rgba(255, 255, 255, 0.96); backdrop-filter: blur(10px);
            border-bottom: 1px solid #DFDFE1; box-shadow: 0 6px 14px rgba(0, 0, 0, 0.02);
            padding: 12px 24px; margin-bottom: 24px;
            display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 16px;
        }
        .logo-area {
            display: flex;
            align-items: center;
            gap: 12px;
            background: #FFFFFF;
            padding: 6px 18px 6px 12px;
            border-radius: 40px;
            border: 1px solid #DFDFE1;
        }
        .logo-icon { background: #52BEC0; width: 34px; height: 34px; border-radius: 50%; display: flex; align-items: center; justify-content: center; color: #000000; font-size: 1.2rem; font-weight: 700; }
        .logo-text { font-weight: 700; font-size: 1rem; letter-spacing: -0.3px; background: linear-gradient(135deg, #000000 0%, #52BEC0 100%); background-clip: text; -webkit-background-clip: text; color: transparent; }
        .filter-group-sticky { display: flex; flex-wrap: wrap; align-items: center; gap: 12px; }
        .segment-buttons { display: flex; gap: 8px; flex-wrap: wrap; }
        .seg-btn {
            background: #FFFFFF; border: 2px solid #DFDFE1; border-radius: 40px;
            padding: 6px 20px; font-size: 0.8rem; font-weight: 500; cursor: pointer;
            transition: all 0.2s ease; color: #000000;
        }
        .seg-btn.active[data-seg="Alto Nivel"] { background: #000000; color: white; border-color: #000000; }
        .seg-btn.active[data-seg="Inversionista"] { background: #3B3B3B; color: white; border-color: #3B3B3B; }
        .seg-btn.active[data-seg="Aspiracional"] { background: #52BEC0; color: #000000; border-color: #52BEC0; }
        .seg-btn.active[data-seg="Patrimonial"] { background: #00FFFF; color: #000000; border-color: #00FFFF; }
        .seg-btn.active[data-seg="todos"] { background: #52BEC0; color: #000000; border-color: #52BEC0; }
        
        .filter-select, .filter-input {
            background: #FFFFFF; border: 1px solid #DFDFE1; border-radius: 40px;
            padding: 6px 16px; font-size: 0.8rem; min-width: 100px; color: #000000;
        }
        .price-range, .age-range { display: flex; gap: 8px; align-items: center; background: #F9FCFE; border-radius: 40px; padding: 0 8px; }
        .price-range input, .age-range input { width: 100px; border: none; background: transparent; padding: 6px 0; outline: none; }
        .btn-reset-sticky { background: #F4F4F6; border: 1px solid #DFDFE1; border-radius: 40px; padding: 6px 20px; cursor: pointer; }
        .btn-reset-sticky:hover { background: #52BEC0; color: #000000; }
        .dashboard-container { max-width: 1600px; margin: 0 auto; padding: 0 24px 32px 24px; }
        .kpi-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 22px; margin-bottom: 36px; }
        .kpi-card { background: #FFFFFF; border-radius: 28px; padding: 20px; border: 1px solid #DFDFE1; transition: 0.2s; }
        .kpi-icon { font-size: 2rem; color: #52BEC0; margin-bottom: 12px; }
        .kpi-label { font-size: 0.7rem; font-weight: 600; text-transform: uppercase; color: #5F5F6B; }
        .kpi-value { font-size: 2.2rem; font-weight: 800; color: #000000; }
        .row-side-by-side {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 28px;
            margin-bottom: 40px;
        }
        .chart-card { background: #FFFFFF; border-radius: 28px; padding: 20px; border: 1px solid #DFDFE1; }
        .chart-title { font-weight: 700; font-size: 1.05rem; margin-bottom: 18px; border-left: 4px solid #52BEC0; padding-left: 14px; color: #000000; }
        canvas { max-height: 280px; width: 100%; }
        .full-width { grid-column: 1 / -1; }
        .full-width canvas { max-height: 400px; }
        .chart-note {
            font-size: 0.7rem;
            color: #6F6F7A;
            margin-top: 12px;
            text-align: center;
            border-top: 1px dashed #DFDFE1;
            padding-top: 10px;
        }
        .table-wrapper { background: #FFFFFF; border-radius: 28px; padding: 20px; overflow-x: auto; border: 1px solid #DFDFE1; margin-top: 8px; }
        table { width: 100%; border-collapse: collapse; font-size: 0.75rem; }
        th { text-align: left; padding: 12px 8px; background: #F8F8FA; border-bottom: 2px solid #DFDFE1; cursor: pointer; user-select: none; transition: background 0.2s; white-space: nowrap; }
        th:hover { background: #E8ECF0; }
        th i { margin-left: 6px; font-size: 0.7rem; color: #6F6F7A; }
        td { padding: 10px 8px; border-bottom: 1px solid #EBEBEE; vertical-align: top; word-break: break-word; max-width: 250px; }
        .badge-seg {
            display: inline-block;
            padding: 4px 12px;
            border-radius: 50px;
            font-size: 0.7rem;
            font-weight: 600;
        }
        .badge-seg.Alto-Nivel { background: #000000; color: white; }
        .badge-seg.Inversionista { background: #3B3B3B; color: white; }
        .badge-seg.Aspiracional { background: #52BEC0; color: #000000; }
        .badge-seg.Patrimonial { background: #00FFFF; color: #000000; }
        .badge-seg.Desconocido { background: #DFDFE1; color: #000000; }
        .pagination { display: flex; justify-content: flex-end; align-items: center; gap: 12px; margin-top: 20px; }
        .pagination button { background: #F4F4F6; border: 1px solid #DFDFE1; border-radius: 30px; padding: 6px 14px; cursor: pointer; font-size: 0.7rem; }
        .pagination button:hover { background: #52BEC0; color: white; }
        .footer-note { text-align: center; font-size: 0.7rem; color: #6F6F7A; margin-top: 30px; padding-top: 20px; border-top: 1px solid #DFDFE1; }
        @media (max-width: 860px) {
            .sticky-filters { flex-direction: column; align-items: stretch; }
            .row-side-by-side { grid-template-columns: 1fr; gap: 28px; }
        }
    </style>
</head>
<body>

<div class="sticky-filters">
    <div class="logo-area">
        <div class="logo-icon">A</div>
        <div class="logo-text">Altaltium</div>
    </div>
    <div class="filter-group-sticky">
        <span style="font-weight: 600;"><i class="fas fa-tag"></i> Segmento:</span>
        <div class="segment-buttons" id="segmentButtons">
            <button data-seg="todos" class="seg-btn active">Todos</button>
            <button data-seg="Inversionista" class="seg-btn">Inversionista</button>
            <button data-seg="Patrimonial" class="seg-btn">Patrimonial</button>
            <button data-seg="Aspiracional" class="seg-btn">Aspiracional</button>
            <button data-seg="Alto Nivel" class="seg-btn">Alto Nivel</button>
        </div>
    </div>
    <div class="filter-group-sticky">
        <span><i class="fas fa-venus-mars"></i> Sexo:</span>
        <select id="sexFilter" class="filter-select">
            <option value="all">Todos</option>
            <option value="M">Masculino</option>
            <option value="F">Femenino</option>
        </select>
    </div>
    <div class="filter-group-sticky">
        <span><i class="fas fa-calendar-alt"></i> Fecha:</span>
        <div class="date-range">
            <input type="date" id="startDate" class="filter-input" placeholder="Desde">
            <input type="date" id="endDate" class="filter-input" placeholder="Hasta">
        </div>
    </div>
    <div class="filter-group-sticky">
        <span><i class="fas fa-dollar-sign"></i> Precio (MXN):</span>
        <div class="price-range">
            <input type="number" id="minPrice" placeholder="Mín" step="10000">
            <span>-</span>
            <input type="number" id="maxPrice" placeholder="Máx" step="10000">
        </div>
    </div>
    <div class="filter-group-sticky">
        <span><i class="fas fa-calendar-week"></i> Edad:</span>
        <div class="age-range">
            <input type="number" id="minAge" placeholder="Mín" step="1">
            <span>-</span>
            <input type="number" id="maxAge" placeholder="Máx" step="1">
        </div>
    </div>
    <div class="filter-group-sticky">
        <span><i class="fas fa-building"></i> # Propiedades:</span>
        <select id="propFilter" class="filter-select">
            <option value="all">Todas</option>
            <option value="1">1 propiedad</option>
            <option value="2">2 propiedades</option>
            <option value="3">3 propiedades</option>
            <option value="4">4+ propiedades</option>
        </select>
    </div>
    <div class="filter-group-sticky">
        <select id="alcaldiaSelectSticky" class="filter-select"><option value="all">Todas las Alcaldías</option></select>
        <select id="profesionSelectSticky" class="filter-select"><option value="all">Todas las Profesiones</option></select>
        <button id="resetStickyBtn" class="btn-reset-sticky"><i class="fas fa-undo-alt"></i> Reset</button>
    </div>
</div>

<div class="dashboard-container">
    <div class="kpi-grid">
        <div class="kpi-card"><div class="kpi-icon"><i class="fas fa-users"></i></div><div class="kpi-label">Total Clientes (Únicos)</div><div class="kpi-value" id="totalClients">-</div></div>
        <div class="kpi-card"><div class="kpi-icon"><i class="fas fa-chart-line"></i></div><div class="kpi-label">Edad Promedio</div><div class="kpi-value" id="avgAge">-</div></div>
        <div class="kpi-card"><div class="kpi-icon"><i class="fas fa-dollar-sign"></i></div><div class="kpi-label">Precio Promedio</div><div class="kpi-value" id="avgPrice">-</div></div>
        <div class="kpi-card"><div class="kpi-icon"><i class="fas fa-calendar-week"></i></div><div class="kpi-label">Rango fechas</div><div class="kpi-value" id="dateRangeKpi">-</div></div>
    </div>

    <div class="row-side-by-side">
        <div class="chart-card">
            <div class="chart-title"><i class="fas fa-chart-scatter"></i> Edad vs Precio (por segmento)</div>
            <canvas id="scatterChart"></canvas>
            <div id="scatterNote" class="chart-note"></div>
        </div>
        <div class="chart-card">
            <div class="chart-title"><i class="fas fa-chart-bar"></i> Distribución por Perfil</div>
            <canvas id="perfilChart"></canvas>
        </div>
    </div>

    <div class="charts-grid" style="display: grid; grid-template-columns: repeat(auto-fill, minmax(460px, 1fr)); gap: 28px; margin-bottom: 40px;">
        <div class="chart-card">
            <div class="chart-title"><i class="fas fa-chart-bar"></i> Clientes por # Propiedades Compradas</div>
            <canvas id="propiedadesChart"></canvas>
        </div>
        <div class="chart-card"><div class="chart-title"><i class="fas fa-venus-mars"></i> Proporción por Sexo</div><canvas id="genderChart"></canvas></div>
        <div class="chart-card"><div class="chart-title"><i class="fas fa-city"></i> Top 10 Alcaldías</div><canvas id="locationChart"></canvas></div>
        <div class="chart-card"><div class="chart-title"><i class="fas fa-chart-line"></i> 📈 Ventas en el tiempo (transacciones)</div><canvas id="timelineChart"></canvas></div>
        <div class="chart-card">
            <div class="chart-title"><i class="fas fa-chart-pie"></i> Estado Civil</div>
            <canvas id="civilChart"></canvas>
            <div id="civilChartNote" class="chart-note"></div>
        </div>
        <div class="chart-card"><div class="chart-title"><i class="fas fa-briefcase"></i> Top Profesiones</div><canvas id="professionChart"></canvas></div>
        <div class="chart-card"><div class="chart-title"><i class="fas fa-chart-line"></i> Precio Promedio por Perfil</div><canvas id="priceByPerfilChart"></canvas></div>
        <div class="chart-card"><div class="chart-title"><i class="fas fa-chart-scatter"></i> Rango de Edad</div><canvas id="ageHistChart"></canvas></div>
    </div>

    <div class="table-wrapper">
        <div style="display:flex; justify-content: space-between; margin-bottom: 12px;"><strong><i class="fas fa-table-list"></i> Todos los registros (transacciones)</strong><span id="rowCountSpan"></span></div>
        <div style="overflow-x: auto;">
            <table id="clientTable">
                <thead id="tableHeader"></thead>
                <tbody id="tableBody"></tbody>
            </table>
        </div>
        <div class="pagination" id="paginationControls">
            <button id="prevPageBtn"><i class="fas fa-chevron-left"></i> Anterior</button>
            <span id="pageInfo">Página 1</span>
            <button id="nextPageBtn">Siguiente <i class="fas fa-chevron-right"></i></button>
        </div>
    </div>
    <div class="footer-note">Filtro de segmento múltiple. Las gráficas de barras muestran valor absoluto y porcentaje.</div>
</div>

<script>
    (function() {
        document.addEventListener('DOMContentLoaded', () => {
            Chart.register(ChartDataLabels);
            Chart.defaults.set('plugins.datalabels', {
                color: '#000000',
                backgroundColor: 'rgba(255,255,255,0.7)',
                borderRadius: 4,
                padding: { left: 4, right: 4, top: 2, bottom: 2 },
                font: { weight: 'bold', size: 10 }
            });

            let transactions = [];
            let clients = [];
            let filteredTransactions = [];
            let filteredClients = [];
            let currentPage = 1;
            const rowsPerPage = 20;
            let sortColumn = 'cliente';
            let sortDirection = 'asc';
            let selectedSegments = [];

            const segmentColors = {
                'Alto Nivel': '#000000',
                'Inversionista': '#3B3B3B',
                'Aspiracional': '#52BEC0',
                'Patrimonial': '#00FFFF',
                'Desconocido': '#DFDFE1'
            };

            function parsePrice(val) {
                if (val === undefined || val === null) return null;
                if (typeof val === 'number') return val;
                let str = String(val).trim();
                str = str.replace(/[^\d,.-]/g, '');
                if (str === '') return null;
                let parts = str.split(',');
                if (parts.length > 2) {
                    let decimalPart = parts.pop();
                    let integerPart = parts.join('');
                    str = integerPart + '.' + decimalPart;
                } else if (parts.length === 2) {
                    if (parts[1].length === 2 && (parts[0].length > 3 || parts[0].includes('.'))) {
                        str = parts[0].replace(/\./g, '') + '.' + parts[1];
                    } else {
                        str = str.replace(/,/g, '');
                    }
                }
                str = str.replace(/\.(?=.*\.)/g, '');
                let num = parseFloat(str);
                return isNaN(num) ? null : num;
            }

            function parseFechaFirma(fechaStr) {
                if (!fechaStr || fechaStr === 'desconocido') return null;
                let clean = fechaStr.replace(/\s+/g, ' ').trim();
                let parts = clean.split(',');
                let datePart = parts.length > 1 ? parts.slice(1).join(',').trim() : clean;
                const meses = {enero:0,febrero:1,marzo:2,abril:3,mayo:4,junio:5,julio:6,agosto:7,septiembre:8,octubre:9,noviembre:10,diciembre:11};
                let match = datePart.match(/(\d{1,2})\s+de\s+([a-zñ]+)\s+de\s+(\d{4})/i);
                if (match) {
                    let day = parseInt(match[1]);
                    let monthName = match[2].toLowerCase();
                    let year = parseInt(match[3]);
                    if (meses[monthName] !== undefined) return new Date(year, meses[monthName], day);
                }
                let d = new Date(datePart);
                return isNaN(d.getTime()) ? null : d;
            }

            function getSegmento(perfilRaw) {
                if (!perfilRaw) return 'Desconocido';
                let lower = perfilRaw.toString().trim().toLowerCase();
                if (lower.includes('alto') && (lower.includes('nivel') || lower.includes('valor') || lower.includes('elite') || lower === 'alto')) {
                    return 'Alto Nivel';
                }
                if (lower === 'inversionista') return 'Inversionista';
                if (lower === 'patrimonial') return 'Patrimonial';
                if (lower === 'aspiracional') return 'Aspiracional';
                return 'Desconocido';
            }

            async function loadData() {
                const sheetCsvUrl = 'https://docs.google.com/spreadsheets/d/1O8GC1KhZnfejdjx-tgjXNG9VfoY2jIx31rSbgrujcP4/export?format=csv&gid=0';
                let fallback = false;
                let rawRows = [];
                try {
                    const resp = await fetch(sheetCsvUrl);
                    if (resp.ok) {
                        const csvText = await resp.text();
                        const parsed = parseCSVToJSON(csvText);
                        if (parsed && parsed.length > 5) {
                            rawRows = parsed;
                            console.log('✅ Datos cargados desde Google Sheets');
                        } else fallback = true;
                    } else fallback = true;
                } catch(e) { fallback = true; }
                if (fallback || rawRows.length === 0) {
                    console.warn('⚠️ Usando datos de respaldo (fallback). Publica la hoja como CSV.');
                    rawRows = getEmbeddedDataset();
                }
                if (rawRows.length > 0) console.log('📋 Columnas detectadas:', Object.keys(rawRows[0]));

                transactions = rawRows.map(r => {
                    let edadVal = r.Edad;
                    let edadNum = edadVal !== undefined && edadVal !== '' ? parseInt(edadVal) : null;
                    let propiedadesRaw = r['# propiedades compradas'];
                    let numProp = (propiedadesRaw !== undefined && propiedadesRaw !== '') ? parseInt(propiedadesRaw) : 0;
                    if (isNaN(numProp)) numProp = 0;
                    return {
                        ...r,
                        precio_total: parsePrice(r.precio_total),
                        edad: edadNum,
                        numPropiedades: numProp,
                        segmento: getSegmento(r.Perfil),
                        alcaldiaClean: (r.alcaldia || r.estado || 'Desconocido').toString().trim(),
                        sexoClean: (r.sexo || '').toUpperCase(),
                        perfilClean: (r.Perfil || 'desconocido').toString(),
                        profesion: r.profesion || 'No especificada',
                        fechaFirma: parseFechaFirma(r.fecha_de_firma),
                        fechaStr: r.fecha_de_firma || '',
                        comentarios: r.comentarios || r.Comentarios || '',
                        clienteNombre: (r.cliente || '').trim()
                    };
                });

                // Crear clientes únicos
                const clientMap = new Map();
                transactions.forEach(t => {
                    const name = t.clienteNombre;
                    if (!name) return;
                    if (!clientMap.has(name)) {
                        clientMap.set(name, {
                            cliente: name,
                            edad: t.edad,
                            sexo: t.sexoClean,
                            alcaldia: t.alcaldiaClean,
                            estado_civil: t.estado_civil,
                            profesion: t.profesion,
                            precio_total: t.precio_total,
                            fechaFirma: t.fechaFirma,
                            fechaStr: t.fechaStr,
                            comentarios: t.comentarios,
                            numPropiedades: t.numPropiedades,
                            perfiles: [t.segmento]
                        });
                    } else {
                        const existing = clientMap.get(name);
                        existing.perfiles.push(t.segmento);
                        if (t.numPropiedades > existing.numPropiedades) existing.numPropiedades = t.numPropiedades;
                        if (t.edad !== null && existing.edad === null) existing.edad = t.edad;
                        if (t.sexoClean && existing.sexo === '') existing.sexo = t.sexoClean;
                        if (t.alcaldiaClean && existing.alcaldia === '') existing.alcaldia = t.alcaldiaClean;
                        if (t.estado_civil && existing.estado_civil === '') existing.estado_civil = t.estado_civil;
                        if (t.profesion && existing.profesion === 'No especificada') existing.profesion = t.profesion;
                        if (t.precio_total !== null && existing.precio_total === null) existing.precio_total = t.precio_total;
                        if (t.fechaFirma && !existing.fechaFirma) existing.fechaFirma = t.fechaFirma;
                        if (t.fechaStr && !existing.fechaStr) existing.fechaStr = t.fechaStr;
                        if (t.comentarios && !existing.comentarios) existing.comentarios = t.comentarios;
                    }
                });
                clients = Array.from(clientMap.values()).map(c => {
                    const freq = {};
                    c.perfiles.forEach(seg => { freq[seg] = (freq[seg] || 0) + 1; });
                    let bestSeg = 'Desconocido';
                    let maxCount = 0;
                    for (const [seg, count] of Object.entries(freq)) {
                        if (count > maxCount) {
                            maxCount = count;
                            bestSeg = seg;
                        } else if (count === maxCount && seg !== 'Desconocido') {
                            bestSeg = seg;
                        }
                    }
                    if (freq['Alto Nivel'] && freq['Alto Nivel'] === maxCount) bestSeg = 'Alto Nivel';
                    return { ...c, segmento: bestSeg, perfiles: undefined };
                });

                console.log('📊 Clientes únicos por perfil:', (() => {
                    const counts = { 'Alto Nivel':0, 'Inversionista':0, 'Patrimonial':0, 'Aspiracional':0, 'Desconocido':0 };
                    clients.forEach(c => counts[c.segmento]++);
                    return counts;
                })());

                populateFilterOptions();
                selectedSegments = [];
                document.querySelectorAll('.seg-btn').forEach(btn => btn.classList.remove('active'));
                const todosBtn = document.querySelector('.seg-btn[data-seg="todos"]');
                if (todosBtn) todosBtn.classList.add('active');
                applyFiltersAndRender();
            }

            function parseCSVToJSON(csv) {
                const workbook = XLSX.read(csv, { type: 'string', raw: true });
                const firstSheet = workbook.Sheets[workbook.SheetNames[0]];
                return XLSX.utils.sheet_to_json(firstSheet, { defval: "" });
            }

            function getEmbeddedDataset() {
                return [
                    { cliente: "Cliente A", Edad: 50, sexo: "F", Perfil: "Aspiracional", alcaldia: "BENITO JUAREZ", estado_civil: "desconocido", profesion: "Docente", precio_total: "1,134,142.37", fecha_de_firma: "sábado, 30 de abril de 2022", comentarios: "ejemplo", "# propiedades compradas": "1" },
                    { cliente: "Cliente B", Edad: 59, sexo: "M", Perfil: "Alto Nivel", alcaldia: "CUAJIMALPA DE MORELOS", estado_civil: "Casado", profesion: "Empresario", precio_total: "2,069,860.00", fecha_de_firma: "jueves, 11 de julio de 2024", comentarios: "", "# propiedades compradas": "2" },
                    { cliente: "Cliente C", Edad: 27, sexo: "F", Perfil: "Aspiracional", alcaldia: "CUAUHTEMOC", estado_civil: "Soltero", profesion: "Diseñadora", precio_total: "878,762.00", fecha_de_firma: "martes, 13 de agosto de 2024", comentarios: "", "# propiedades compradas": "1" },
