                    const normalPoints = [];
                    const outlierPoints = [];
                    filteredTransactions.forEach(t => {
                        if (t.segmento === seg && t.edad !== null && t.precio_total !== null) {
                            if (t.precio_total > maxY) {
                                outlierCount++;
                                outlierPoints.push({ x: t.edad, y: maxY, originalY: t.precio_total });
                            } else {
                                normalPoints.push({ x: t.edad, y: t.precio_total });
                            }
                        }
                    });
                    if (normalPoints.length) datasetsScatter.push({ label: seg, data: normalPoints, backgroundColor: color, borderColor: colorBlack, borderWidth: 1, pointRadius: 5, pointHoverRadius: 7, pointStyle: 'circle' });
                    if (outlierPoints.length) datasetsScatter.push({ label: seg + ' (>5M)', data: outlierPoints, backgroundColor: color, borderColor: '#FF0000', borderWidth: 2, pointRadius: 6, pointHoverRadius: 8, pointStyle: 'triangle' });
                });
                if(charts.scatter) charts.scatter.destroy();
                if(datasetsScatter.length) {
                    charts.scatter = new Chart(document.getElementById('scatterChart'), { type: 'scatter', data: { datasets: datasetsScatter }, options: { scales: { x: { title: { display: true, text: 'Edad (años)' } }, y: { min: 0, max: maxY, title: { display: true, text: 'Precio Total (MXN)' }, ticks: { callback: (val) => '$' + val.toLocaleString() } } }, plugins: { tooltip: { callbacks: { label: (ctx) => ctx.raw.originalY ? `${ctx.dataset.label.replace(' (>5M)', '')}: Edad ${ctx.raw.x} años, Precio $${ctx.raw.originalY.toLocaleString()} (fuera de escala)` : `${ctx.dataset.label}: Edad ${ctx.raw.x} años, Precio $${ctx.raw.y.toLocaleString()}` } }, datalabels: { display: false } } } });
                } else { const ctx = document.getElementById('scatterChart').getContext('2d'); charts.scatter = new Chart(ctx, { type: 'scatter', data: { datasets: [] } }); }
                const scatterNote = document.getElementById('scatterNote');
                if (scatterNote) scatterNote.innerHTML = outlierCount > 0 ? `⚠️ ${outlierCount} transacción(es) con precio > $5M (triángulos rojos en borde superior).` : '';

                // 2. Perfil (barras con porcentaje)
                let segCount = {'Alto Nivel':0, 'Inversionista':0, 'Patrimonial':0, 'Aspiracional':0};
                filteredClients.forEach(c => { if (c.segmento !== 'Desconocido') segCount[c.segmento]++; });
                let totalPerfiles = Object.values(segCount).reduce((a,b)=>a+b,0);
                if(charts.perfil) charts.perfil.destroy();
