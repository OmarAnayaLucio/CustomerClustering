                // 10. Rango de Edad (barras con %)
                let ageRanges = {'20-29':0,'30-39':0,'40-49':0,'50-59':0,'60+':0};
                filteredClients.forEach(c=>{ let e=c.edad; if(e){ if(e<30) ageRanges['20-29']++; else if(e<40) ageRanges['30-39']++; else if(e<50) ageRanges['40-49']++; else if(e<60) ageRanges['50-59']++; else ageRanges['60+']++; } });
                let totalAge = Object.values(ageRanges).reduce((a,b)=>a+b,0);
