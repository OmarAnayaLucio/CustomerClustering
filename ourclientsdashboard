                // 4. Sexo (pastel con % ya tiene)
                let male = filteredClients.filter(c=>c.sexo==='M').length, female = filteredClients.filter(c=>c.sexo==='F').length;
                if(charts.gender) charts.gender.destroy();
                charts.gender = new Chart(document.getElementById('genderChart'), { type:'pie', data:{ labels:['Masculino','Femenino'], datasets:[{ data:[male,female], backgroundColor:[colorPrimary, colorSecondary], borderColor:colorBlack, borderWidth:1 }] }, options:{ plugins:{ datalabels:{ formatter:(val,ctx)=> { let total=male+female; let pct=total?((val/total)*100).toFixed(1):0; return `${val} (${pct}%)`; } } } } });

                // 5. Alcaldías (barras con %)
                let alcalFreq = {};
                filteredClients.forEach(c=>{ let a=c.alcaldia; if(a) alcalFreq[a]=(alcalFreq[a]||0)+1; });
                let topAlcal = Object.entries(alcalFreq).sort((a,b)=>b[1]-a[1]).slice(0,10);
                let totalAlcal = topAlcal.reduce((s, e) => s + e[1], 0);
                if(charts.location) charts.location.destroy();
                charts.location = new Chart(document.getElementById('locationChart'), { type:'bar', data:{ labels:topAlcal.map(e=>e[0]), datasets:[{ label:'Clientes', data:topAlcal.map(e=>e[1]), backgroundColor:colorPrimary, borderColor:colorBlack, borderWidth:1, borderRadius:6 }] }, options:{ plugins:{ datalabels:{ anchor:'end', align:'top', formatter:(val) => `${val} (${totalAlcal?((val/totalAlcal)*100).toFixed(1):0}%)` } } } });

                // 6. Línea temporal (sin %)
                let monthly = {};
                filteredTransactions.forEach(t => { if(t.fechaFirma) { let key = `${t.fechaFirma.getFullYear()}-${String(t.fechaFirma.getMonth()+1).padStart(2,'0')}`; monthly[key] = (monthly[key]||0)+1; } });
                let sortedMonths = Object.keys(monthly).sort();
                if(charts.timeline) charts.timeline.destroy();
