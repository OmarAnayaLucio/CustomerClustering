                // 3. Propiedades (barras con porcentaje)
                let propCount = { '1':0, '2':0, '3':0, '4+':0 };
                filteredClients.forEach(c => {
                    let n = c.numPropiedades;
                    if (n === 1) propCount['1']++;
                    else if (n === 2) propCount['2']++;
                    else if (n === 3) propCount['3']++;
                    else if (n >= 4) propCount['4+']++;
                });
                let propLabels = ['1', '2', '3', '4+'];
                let propData = propLabels.map(l => propCount[l]);
