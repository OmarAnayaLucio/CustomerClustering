            function renderTableWithPagination() {
                const start = (currentPage - 1) * rowsPerPage;
                const end = start + rowsPerPage;
                const pageData = filteredTransactions.slice(start, end);
                const headers = [
                    { key: 'cliente', label: 'Cliente' },
                    { key: 'edad', label: 'Edad' },
                    { key: 'sexo', label: 'Sexo' },
                    { key: 'perfil', label: 'Perfil' },
                    { key: 'propiedades', label: '# Propiedades' },
                    { key: 'alcaldia', label: 'Alcaldía' },
                    { key: 'estado_civil', label: 'Estado Civil' },
                    { key: 'fecha_firma', label: 'Fecha Firma' },
                    { key: 'precio_total', label: 'Precio Total' },
                    { key: 'comentarios', label: 'Comentarios' }
                ];
                const headerHtml = headers.map(h => {
                    let icon = sortColumn === h.key ? (sortDirection === 'asc' ? '<i class="fas fa-arrow-up"></i>' : '<i class="fas fa-arrow-down"></i>') : '<i class="fas fa-sort" style="opacity:0.4"></i>';
                    return `<th data-sort="${h.key}">${h.label} ${icon}</th>`;
                }).join('');
                const tableHeader = document.getElementById('tableHeader');
                const tableBody = document.getElementById('tableBody');
                if (tableHeader) tableHeader.innerHTML = `<tr>${headerHtml}</tr>`;
                if (tableBody) tableBody.innerHTML = pageData.map(t => `
                    <tr>
                        <td>${t.clienteNombre || '—'}</td>
                        <td>${t.edad !== null ? t.edad : '—'}</td>
                        <td>${t.sexoClean || '—'}</td>
                        <td><span class="badge-seg ${t.segmento.replace(/\s/g, '-')}">${t.segmento}</span></td>
                        <td>${t.numPropiedades}</td>
                        <td>${t.alcaldiaClean}</td>
                        <td>${t.estado_civil || '—'}</td>
                        <td>${t.fechaStr ? t.fechaStr.substring(0,16) : '—'}</td>
                        <td>${t.precio_total ? '$'+t.precio_total.toLocaleString() : '—'}</td>
                        <td>${t.comentarios ? t.comentarios.substring(0, 100) + (t.comentarios.length > 100 ? '…' : '') : '—'}</td>
                    </tr>
                `).join('');
                const rowSpan = document.getElementById('rowCountSpan');
                if (rowSpan) rowSpan.innerHTML = `${filteredTransactions.length} registros (pág. ${currentPage}/${Math.ceil(filteredTransactions.length/rowsPerPage) || 1})`;
                attachTableSortEvents();
            }

            function attachTableSortEvents() {
                document.querySelectorAll('#clientTable th').forEach(th => {
                    th.removeEventListener('click', handleSortClick);
                    th.addEventListener('click', handleSortClick);
                });
            }

            function handleSortClick(e) {
                const th = e.currentTarget;
                const sortKey = th.getAttribute('data-sort');
                if (!sortKey) return;
                if (sortColumn === sortKey) sortDirection = sortDirection === 'asc' ? 'desc' : 'asc';
                else { sortColumn = sortKey; sortDirection = 'asc'; }
                applySortingToFilteredTransactions();
                currentPage = 1;
                renderTableWithPagination();
                updatePaginationControls();
            }

            function updatePaginationControls() {
                const totalPages = Math.ceil(filteredTransactions.length / rowsPerPage);
                const pageInfo = document.getElementById('pageInfo');
                const prevBtn = document.getElementById('prevPageBtn');
                const nextBtn = document.getElementById('nextPageBtn');
                if (pageInfo) pageInfo.innerText = `Página ${currentPage} de ${totalPages || 1}`;
                if (prevBtn) prevBtn.disabled = currentPage === 1;
                if (nextBtn) nextBtn.disabled = currentPage === totalPages || totalPages === 0;
            }

            function nextPage() { if (currentPage < Math.ceil(filteredTransactions.length / rowsPerPage)) { currentPage++; renderTableWithPagination(); updatePaginationControls(); } }
            function prevPage() { if (currentPage > 1) { currentPage--; renderTableWithPagination(); updatePaginationControls(); } }

            function bindEvents() {
                const segBtns = document.querySelectorAll('.seg-btn');
                const todosBtn = document.querySelector('.seg-btn[data-seg="todos"]');

                segBtns.forEach(btn => {
                    btn.addEventListener('click', () => {
                        const seg = btn.getAttribute('data-seg');
                        if (seg === 'todos') {
                            selectedSegments = [];
                            segBtns.forEach(b => b.classList.remove('active'));
                            todosBtn.classList.add('active');
                        } else {
                            if (btn.classList.contains('active')) {
                                btn.classList.remove('active');
                                selectedSegments = selectedSegments.filter(s => s !== seg);
                            } else {
                                btn.classList.add('active');
                                selectedSegments.push(seg);
                            }
                            if (selectedSegments.length === 0) {
                                todosBtn.classList.add('active');
                            } else {
                                todosBtn.classList.remove('active');
                            }
                        }
                        applyFiltersAndRender();
                    });
                });

                const sexFilter = document.getElementById('sexFilter');
                const startDate = document.getElementById('startDate');
                const endDate = document.getElementById('endDate');
                const minPrice = document.getElementById('minPrice');
                const maxPrice = document.getElementById('maxPrice');
                const minAge = document.getElementById('minAge');
                const maxAge = document.getElementById('maxAge');
                const alcaldia = document.getElementById('alcaldiaSelectSticky');
                const profesion = document.getElementById('profesionSelectSticky');
                const propFilter = document.getElementById('propFilter');
                const resetBtn = document.getElementById('resetStickyBtn');

                if (sexFilter) sexFilter.addEventListener('change', applyFiltersAndRender);
                if (startDate) startDate.addEventListener('change', applyFiltersAndRender);
                if (endDate) endDate.addEventListener('change', applyFiltersAndRender);
                if (minPrice) minPrice.addEventListener('input', applyFiltersAndRender);
                if (maxPrice) maxPrice.addEventListener('input', applyFiltersAndRender);
                if (minAge) minAge.addEventListener('input', applyFiltersAndRender);
                if (maxAge) maxAge.addEventListener('input', applyFiltersAndRender);
                if (alcaldia) alcaldia.addEventListener('change', applyFiltersAndRender);
                if (profesion) profesion.addEventListener('change', applyFiltersAndRender);
                if (propFilter) propFilter.addEventListener('change', applyFiltersAndRender);

                if (resetBtn) resetBtn.addEventListener('click', () => {
                    selectedSegments = [];
                    segBtns.forEach(b => b.classList.remove('active'));
                    if (todosBtn) todosBtn.classList.add('active');
                    if (sexFilter) sexFilter.value = 'all';
                    if (startDate) startDate.value = '';
                    if (endDate) endDate.value = '';
                    if (minPrice) minPrice.value = '';
                    if (maxPrice) maxPrice.value = '';
                    if (minAge) minAge.value = '';
                    if (maxAge) maxAge.value = '';
                    if (alcaldia) alcaldia.value = 'all';
                    if (profesion) profesion.value = 'all';
                    if (propFilter) propFilter.value = 'all';
                    sortColumn = 'cliente';
                    sortDirection = 'asc';
                    applyFiltersAndRender();
                });

                const prevBtn = document.getElementById('prevPageBtn');
                const nextBtn = document.getElementById('nextPageBtn');
                if (prevBtn) prevBtn.addEventListener('click', prevPage);
                if (nextBtn) nextBtn.addEventListener('click', nextPage);
            }

            loadData().then(() => { bindEvents(); }).catch(err => console.error('Error en la carga:', err));
        });
    })();
</script>
</body>
</html>
