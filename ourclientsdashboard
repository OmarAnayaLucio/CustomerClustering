                if(Object.keys(civilMap).length) {
                    charts.civil = new Chart(document.getElementById('civilChart'), { type:'doughnut', data:{ labels:Object.keys(civilMap), datasets:[{ data:Object.values(civilMap), backgroundColor:[colorPrimary, colorSecondary, '#52BEC0aa', '#00FFFFaa'], borderColor:colorBlack, borderWidth:1 }] }, options:{ plugins:{ datalabels:{ color:colorBlack, backgroundColor:'rgba(255,255,255,0.85)', formatter:(val,ctx)=> { let total=Object.values(civilMap).reduce((a,b)=>a+b,0); let pct=total?((val/total)*100).toFixed(1):0; return `${val} (${pct}%)`; } } } } });
                } else { const ctx = document.getElementById('civilChart').getContext('2d'); charts.civil = new Chart(ctx, { type:'doughnut', data:{ labels:[], datasets:[] } }); }
                const civilNote = document.getElementById('civilChartNote');
                if (civilNote) civilNote.innerHTML = unknownCount>0 ? `⚠️ ${unknownCount} cliente(s) sin información de estado civil (excluidos).` : '';

                // 8. Profesiones (barras con %)
                let profMap = {};
                filteredClients.forEach(c => { let p = c.profesion || 'No especificada'; if(p !== 'No especificada') profMap[p] = (profMap[p]||0)+1; });
                let topProf = Object.entries(profMap).sort((a,b)=>b[1]-a[1]).slice(0,6);
                let totalProf = topProf.reduce((s, e) => s + e[1], 0);
                if(charts.prof) charts.prof.destroy();
                charts.prof = new Chart(document.getElementById('professionChart'), { type:'bar', data:{ labels:topProf.map(p=>p[0]), datasets:[{ label:'Clientes', data:topProf.map(p=>p[1]), backgroundColor:colorBlack, borderColor:colorPrimary, borderWidth:2, borderRadius:6 }] }, options:{ plugins:{ datalabels:{ anchor:'end', align:'top', formatter:(val) => `${val} (${totalProf?((val/totalProf)*100).toFixed(1):0}%)` } } } });

                // 9. Precio promedio por perfil (sin %)
                let priceBySeg = {};
                filteredClients.forEach(c => { if(c.precio_total && c.segmento !== 'Desconocido') { if(!priceBySeg[c.segmento]) priceBySeg[c.segmento]=[]; priceBySeg[c.segmento].push(c.precio_total); } });
